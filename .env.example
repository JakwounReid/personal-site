# Copy to .env.local and fill in. Never commit real values.

# --- Analytics / existing integrations ---
WAITLIST_WEBHOOK_URL=
NEXT_PUBLIC_CLARITY_ID=
DASHBOARD_SECRET=
API_BASE_URL=

# --- Email capture (/api/subscribe, /api/unsubscribe) ---
# Supabase project REST URL, e.g. https://xxxx.supabase.co
SUPABASE_URL=
# Service role key (server-only — bypasses RLS, never expose to the client)
SUPABASE_SERVICE_ROLE_KEY=
# Secret used to sign unsubscribe links. Optional — falls back to the service
# role key if unset, but set a dedicated value in production.
UNSUBSCRIBE_SECRET=
